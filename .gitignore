# Local Python environments and caches.
.venv*/
venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Downloaded/converted models and generated build or test artifacts.
/models/
/artifacts/
/build/
/dist/
# Test packages, including testbuild-new, testbuild_01 and TestBuild.
[Tt]est[Bb]uild*/
/publish/
/publish-*/
**/[Bb]in/
**/[Oo]bj/
**/TestResults/
# Runtime binaries, installers and symbols accidentally copied outside build folders.
*.exe
*.dll
*.pdb
*.lib
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.nupkg
*.snupkg
# Model weights and experiment tensors belong in local model/output folders.
*.onnx
*.onnx.data
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
*.bin
*.npy
*.npz
*.f32
# Archives of local application packages.
[Tt]est[Bb]uild*.zip
[Tt]est[Bb]uild*.7z
[Tt]est[Bb]uild*.tar
[Tt]est[Bb]uild*.tar.gz
AIrtist-preview*.zip
AIrtist-preview*.7z
*.log
*.binlog
*.trx
*.partial
*.tmp
*.dmp
onnxruntime_profile_*.json

# Local credentials and IDE/OS state. Keep shareable example configuration.
.env
.env.*
!.env.example
!.env.sample
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user
# Local deployment profiles, credentials and private signing keys.
*.pubxml
*.pubxml.user
*.publishsettings
secrets.json
# EOS SDK downloads and per-developer connection credentials.
/sdks/
eos.local.json
EOS-SDK*.zip
EOSSDK*.zip
appsettings.Local.json
appsettings.*.local.json
*.pfx
*.p12
*.key
*.pem
Thumbs.db
Desktop.ini
.DS_Store

# Outputs are local by default: images, latents, profiles, execution snapshots,
# machine inventories and intermediate measurements must not enter Git.
# Keep only reviewed reports, pinned model provenance and license notices.
/outputs/*
!/outputs/tiny-sd/
/outputs/tiny-sd/*
!/outputs/tiny-sd/BASELINE_REPORT.md
!/outputs/tiny-sd/model-manifest.json
!/outputs/tiny-sd/provenance.json
!/outputs/tiny-sd/upstream-distill-sd-LICENSE.txt
!/outputs/tiny-sd/stage2/
/outputs/tiny-sd/stage2/*
!/outputs/tiny-sd/stage2/COMPRESSION_REPORT.md
!/outputs/tiny-sd/stage2/WORKSPACE_SIZE.md
!/outputs/tiny-sd/stage2/taesd-manifest.json
!/outputs/tiny-sd/stage2/variant-manifests.json
!/outputs/tiny-sd/stage2/TAESD_LICENSE.txt
!/outputs/tiny-sd/stage2/ONNXRuntime_LICENSE.txt
!/outputs/tiny-sd/stage2/ONNXRuntime_ThirdPartyNotices.txt
