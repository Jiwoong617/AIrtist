<Window x:Class="AIrtist.App.RoundPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIrtist · 경기 미리보기" Width="1180" Height="850" MinWidth="940" MinHeight="650" Background="#101722" Foreground="#EDF1F6" WindowStartupLocation="CenterOwner">
  <Grid x:Name="Page" Background="#101722" Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock x:Name="WindowHeading" Text="경기 미리보기" FontSize="26" FontWeight="Bold"/>
      <TextBlock x:Name="WindowHint" Text="한 PC에서 역할을 바꾸며 여러 라운드를 체험합니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,14" VerticalAlignment="Center">
      <StackPanel x:Name="Setup" Orientation="Horizontal">
        <TextBlock x:Name="CountCaption" Text="인원" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="Count" Width="52" SelectedIndex="1" Margin="0,0,16,0"/>
        <TextBlock Text="라운드" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="RoundCount" Width="52" Margin="0,0,16,0"/>
        <TextBlock x:Name="WordCaption" Text="첫 제시어" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="WordChoice" Width="86" DisplayMemberPath="Korean" Margin="0,0,16,0"/>
        <TextBlock Text="작성(초)" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="WritingSeconds" Text="300" Width="45" MaxLength="3" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock Text="생성(초)" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="GenerationSeconds" Text="180" Width="45" MaxLength="3" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
      </StackPanel>
      <Button x:Name="CreateLobby" Content="대기방 만들기" Click="CreateLobbyClicked" Padding="14,8" Margin="0,0,8,0"/>
      <Button x:Name="ApplySettings" Content="설정 적용" Click="ApplySettingsClicked" Padding="14,8" Margin="0,0,8,0" Visibility="Collapsed"/>
      <Button x:Name="Start" Content="방장: 경기 시작" Click="StartClicked" Padding="14,8" Margin="0,0,8,0" IsEnabled="False"/>
      <Button x:Name="Reset" Content="다시 설정" Click="ResetClicked" Padding="14,8" Background="#344052" Foreground="#EDF1F6" IsEnabled="False"/>
    </WrapPanel>
    <Border Grid.Row="2" Background="#1B2937" CornerRadius="12" Padding="16" Margin="0,0,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="MatchLabel" Foreground="#A7E3C2" Margin="0,0,0,6"/>
          <TextBlock x:Name="Prompt" Text="설정을 정하고 대기방을 만드세요" FontSize="20" FontWeight="Bold"/>
          <TextBlock x:Name="Meaning" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,16,0"/>
          <TextBlock x:Name="ClockLabel" Foreground="#A7E3C2" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel x:Name="RolePanel" Grid.Column="1" Width="142"><TextBlock Text="현재 조작하는 역할" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
          <ComboBox x:Name="Viewer" DisplayMemberPath="Name" SelectionChanged="ViewerChanged" MinHeight="30"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="LobbyPanel" Grid.Row="3" Background="#1B2937" CornerRadius="12" Padding="24">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="경기 전 대기방" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="LobbySettingsLabel" Foreground="#A7E3C2" TextWrapping="Wrap" Margin="0,12,0,12"/>
        <TextBlock x:Name="LobbyMembersLabel" Text="인원과 시간을 정한 뒤 대기방을 만들어 주세요." FontSize="17" TextWrapping="Wrap" LineHeight="32"/>
        <Button x:Name="Ready" Content="준비 완료" Click="ReadyClicked" HorizontalAlignment="Left" Margin="0,20,0,16" IsEnabled="False"/>
        <TextBlock x:Name="LobbyGuide" Text="현재 조작하는 역할을 바꾸어 각 참가자를 준비시켜 주세요. 모두 준비하면 방장이 경기를 시작합니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        <TextBlock x:Name="LobbyPolicy" Text="설정·참가자가 바뀌면 모두 다시 준비해야 합니다. 이 화면은 한 PC의 로컬 미리보기입니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel></ScrollViewer>
    </Border>
    <Grid x:Name="MatchContent" Grid.Row="3" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="01  제시어를 쓰지 않고 묘사하기" FontSize="16" FontWeight="Bold"/>
          <TextBox x:Name="Description" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="98" MaxLength="160" Padding="12" FontSize="15" Margin="0,10,0,10"/>
          <Button x:Name="Translate" Content="번역 준비" Click="TranslateClicked" IsEnabled="False"/>
          <TextBlock Text="02  영어 묘사 확인·수정" FontSize="16" FontWeight="Bold" Margin="0,20,0,0"/>
          <TextBlock Text="원문에 없는 대상·속성을 고쳐 주세요. 확인 시간도 작성 제한에 포함됩니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
          <TextBox x:Name="English" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="92" MaxLength="320" Padding="12" FontSize="15" Margin="0,10,0,10" IsEnabled="False"/>
          <Button x:Name="Confirm" Content="최종 제출 · 한 장 생성" Click="ConfirmClicked" IsEnabled="False"/>
          <WrapPanel Margin="0,8,0,0">
            <Button x:Name="Revise" Content="원문 고치기" Click="ReviseClicked" Background="#344052" Foreground="#EDF1F6" IsEnabled="False" Margin="0,0,8,0" Padding="14,9"/>
            <Button x:Name="Cancel" Content="작업 취소" Click="CancelClicked" Background="#344052" Foreground="#EDF1F6" IsEnabled="False" Padding="14,9"/>
          </WrapPanel>
          <TextBlock Text="승인 후에는 생성 기회가 소비됩니다. 취소·실패해도 다시 생성할 수 없습니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <TextBlock x:Name="ProgressLabel" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border x:Name="HistoryPanel" Background="#1B2937" CornerRadius="10" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel><TextBlock Text="라운드별 득표 기록" FontSize="17" FontWeight="Bold"/>
              <TextBlock x:Name="HistoryLabel" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,8"/>
              <TextBlock Text="최종 우승 기준은 아직 정하지 않았습니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <Button x:Name="NextRound" Content="방장: 다음 라운드" Click="NextRoundClicked" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="GalleryTitle" Text="생성한 그림" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock x:Name="GalleryHint" Text="다른 역할로 바꾸어 모든 참가자의 그림을 만들어 주세요." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Image x:Name="OwnImage" Height="300" Stretch="Uniform" Visibility="Collapsed"/>
          <ItemsControl x:Name="Cards">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Width="218" Padding="10" Margin="0,0,10,12" Background="#1B2937" BorderBrush="{Binding Outline}" BorderThickness="2" CornerRadius="12">
                <StackPanel><Image Source="{Binding Image}" Height="184" Stretch="Uniform"/>
                  <TextBlock Text="{Binding Label}" Foreground="#EDF1F6" TextWrapping="Wrap" Margin="0,9,0,4"/>
                  <TextBlock Text="{Binding Votes}" Foreground="#A7E3C2" Margin="0,0,0,8"/>
                  <Button Content="{Binding Action}" Tag="{Binding Id}" IsEnabled="{Binding CanVote}" Click="VoteClicked" Padding="10,8"/>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ResultLabel" FontSize="18" Foreground="#A7E3C2" TextWrapping="Wrap" Margin="0,4,0,12"/>
          <Button x:Name="CloseVote" Content="방장: 투표 마감" Click="CloseVoteClicked" Visibility="Collapsed" HorizontalAlignment="Left" Background="#344052" Foreground="#EDF1F6"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="4" x:Name="StatusLabel" Text="작성·생성 시간은 임시 설정입니다. 생성은 이 PC에서 한 번에 하나씩 실행됩니다." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
  </Grid>
</Window>
