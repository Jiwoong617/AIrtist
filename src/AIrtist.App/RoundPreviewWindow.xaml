<local:GameScreen x:Class="AIrtist.App.RoundPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AIrtist.App" Background="{DynamicResource PageBackground}" Foreground="{DynamicResource Ink}" FontFamily="Malgun Gothic" FontSize="14">
  <Grid x:Name="Page" Background="{DynamicResource PageBackground}" Margin="24">
    <Grid x:Name="RoundPage">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <Button x:Name="OnlineRoomCode" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Click="CopyOnlineCodeClicked" ToolTip="방 코드 복사"/>
      <Button x:Name="Reset" DockPanel.Dock="Right" VerticalAlignment="Top" Content="다시 설정" Click="ResetClicked" Margin="0,0,12,0" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
      <StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"><Run Text="AI" Foreground="{DynamicResource Accent}"/><Run Text="rtist"/></TextBlock>
        <Border Width="1" Height="24" Background="{DynamicResource CardBorder}" Margin="20,0"/>
        <TextBlock x:Name="WindowHeading" Text="경기 미리보기" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="WindowHint" Text="한 PC에서 역할을 바꾸며 여러 라운드를 체험합니다." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </DockPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,14" VerticalAlignment="Center">
      <StackPanel x:Name="Setup" Orientation="Horizontal">
        <TextBlock x:Name="CountCaption" Text="인원" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="Count" Width="62" SelectedIndex="1" Margin="0,0,16,0"/>
        <TextBlock Text="라운드" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="RoundCount" Width="62" Margin="0,0,16,0"/>
        <TextBlock x:Name="WordCaption" Text="첫 제시어" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="WordChoice" Width="86" DisplayMemberPath="Korean" Margin="0,0,16,0"/>
        <TextBlock Text="작성(초)" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="WritingSeconds" Text="300" Width="64" MaxLength="3" Padding="8" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock Text="생성(초)" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="GenerationSeconds" Text="180" Width="64" MaxLength="3" Padding="8" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
      </StackPanel>
      <Button x:Name="CreateLobby" Content="대기방 만들기" Click="CreateLobbyClicked" Padding="14,8" Margin="0,0,8,0"/>
      <Button x:Name="ApplySettings" Content="설정 적용" Click="ApplySettingsClicked" Padding="14,8" Margin="0,0,8,0" Visibility="Collapsed"/>
      <Button x:Name="Start" Content="방장: 경기 시작" Click="StartClicked" Padding="14,8" Margin="0,0,8,0" IsEnabled="False"/>
    </WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" CornerRadius="22" Padding="16" Margin="0,0,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="MatchLabel" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>
          <TextBlock x:Name="Prompt" Text="설정을 정하고 대기방을 만드세요" FontSize="20" FontWeight="Bold"/>
          <TextBlock x:Name="Meaning" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,16,0"/>
          <TextBlock x:Name="ClockLabel" Foreground="{DynamicResource Accent}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel x:Name="RolePanel" Grid.Column="1" Width="142"><TextBlock Text="현재 조작하는 역할" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
          <ComboBox x:Name="Viewer" DisplayMemberPath="Name" SelectionChanged="ViewerChanged" MinHeight="30"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="LobbyPanel" Grid.Row="3" Style="{StaticResource Card}" CornerRadius="22" Padding="24">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="경기 전 대기방" FontSize="22" FontWeight="Bold"/>
        <CheckBox x:Name="LockRoomParameters" Content="방 파라미터 설정" Foreground="{DynamicResource Ink}" Margin="0,16,0,10" Checked="RoomParametersChanged" Unchecked="RoomParametersChanged"/><local:ParameterEditor x:Name="RoomParameters" Width="210" HorizontalAlignment="Left" Visibility="Collapsed"/><TextBlock x:Name="LobbySettingsLabel" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,12,0,12"/>
        <TextBlock x:Name="LobbyMembersLabel" Text="인원과 시간을 정한 뒤 대기방을 만들어 주세요." FontSize="17" TextWrapping="Wrap" LineHeight="32"/>
        <Button x:Name="Ready" Content="준비 완료" Click="ReadyClicked" HorizontalAlignment="Left" Margin="0,20,0,16" IsEnabled="False"/>
        <TextBlock x:Name="LobbyGuide" Text="현재 조작하는 역할을 바꾸어 각 참가자를 준비시켜 주세요. 모두 준비하면 방장이 경기를 시작합니다." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        <TextBlock x:Name="LobbyPolicy" Text="설정·참가자가 바뀌면 모두 다시 준비해야 합니다. 이 화면은 한 PC의 로컬 미리보기입니다." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel></ScrollViewer>
    </Border>
    <Grid x:Name="MatchContent" Grid.Row="3" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="ParameterPanel" Style="{StaticResource Card}" Padding="20" CornerRadius="22" Margin="0,0,0,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <TextBlock Text="생성 설정" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
          <TextBlock x:Name="ParameterPolicyLabel" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <local:ParameterEditor x:Name="Parameters"/>
          <TextBlock x:Name="ProgressLabel" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,18,0,0"/>
        </StackPanel></ScrollViewer>
      </Border>
      <Border x:Name="PromptComposer" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" CornerRadius="22" Padding="16" Margin="0,8,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="제시어를 쓰지 않고 묘사하기" FontWeight="Bold"/>
            <TextBox x:Name="Description" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="64" MaxLength="160" Padding="8" FontSize="15" Margin="0,8,0,8"/>
            <Button Visibility="Collapsed" x:Name="Revise" Content="원문 고치기" Click="ReviseClicked" Style="{StaticResource SecondaryButton}" IsEnabled="False" Padding="12,7"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Visibility="Collapsed" Text="영어 묘사 확인 · 작성 시간에 포함돼요" FontWeight="Bold"/>
            <TextBox Visibility="Collapsed" x:Name="English" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="64" MaxLength="320" Padding="8" FontSize="15" Margin="0,8,0,8" IsEnabled="False"/>
            <Button Visibility="Collapsed" x:Name="Confirm" Content="최종 제출 · 한 장 생성" Click="ConfirmClicked" IsEnabled="False" Padding="12,7"/>
            <Button x:Name="Translate" Content="그림 그리기" Click="DrawClicked" IsEnabled="False"/>
            <Button x:Name="Cancel" Content="취소" Click="CancelClicked" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,6,0,0" Padding="10,6"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="GallerySurface" Grid.Column="2" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock x:Name="GalleryTitle" Text="생성한 그림" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock x:Name="GalleryHint" Text="다른 역할로 바꾸어 모든 참가자의 그림을 만들어 주세요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Image x:Name="OwnImage" Height="260" Stretch="Uniform" Visibility="Collapsed"/>
          <ItemsControl x:Name="Cards">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Width="218" Padding="10" Margin="0,0,10,12" Style="{StaticResource Card}" Background="{DynamicResource FieldSurface}" BorderBrush="{Binding Outline}" BorderThickness="2" CornerRadius="16">
                <StackPanel><Image Source="{Binding Image}" Height="184" Stretch="Uniform"/>
                  <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,9,0,4"/>
                  <TextBlock Text="{Binding Votes}" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                  <Button Content="{Binding Action}" Tag="{Binding Id}" IsEnabled="{Binding CanVote}" Click="VoteClicked" Padding="10,8"/>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ResultLabel" FontSize="18" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,4,0,12"/>
          <Border x:Name="HistoryPanel" Style="{StaticResource Card}" CornerRadius="10" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel><TextBlock Text="라운드별 득표 기록" FontSize="17" FontWeight="Bold"/>
              <TextBlock x:Name="HistoryLabel" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,8"/>
              <Button x:Name="NextRound" Content="방장: 다음 라운드" Click="NextRoundClicked" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
              <Button x:Name="ShowFinal" Content="최종 결과" Click="ShowFinalClicked" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <Button x:Name="CloseVote" Content="방장: 투표 마감" Click="CloseVoteClicked" Visibility="Collapsed" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
      </ScrollViewer>
      </Border>
    </Grid>
    <TextBlock Grid.Row="4" x:Name="StatusLabel" Text="작성·생성 시간은 임시 설정입니다. 생성은 이 PC에서 한 번에 하나씩 실행됩니다." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>
    </Grid>
    <local:FinalResultsView x:Name="FinalResults" Visibility="Collapsed" LeaveRequested="FinalLeaveRequested"/>
  </Grid>
</local:GameScreen>
