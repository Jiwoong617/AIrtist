<Window x:Class="AIrtist.App.MenuWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIrtist" Width="1120" Height="820" MinWidth="940" MinHeight="740" Background="White" Foreground="Black" WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic">
  <Window.Resources>
    <Style x:Key="MenuButton" TargetType="Button">
      <Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="Black"/>
      <Setter Property="Padding" Value="28,8"/><Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F2F2F2"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="Black"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="MenuPage" Background="White">
    <StackPanel x:Name="MainMenu" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
      <TextBlock Text="AIrtist" FontFamily="Segoe UI" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,42"/>
      <Button x:Name="Single" Style="{StaticResource MenuButton}" Content="그림 그리기" Click="SingleClicked"/>
      <Button x:Name="Multi" Style="{StaticResource MenuButton}" Content="멀티 플레이" Click="MultiClicked"/>
      <Button x:Name="Settings" Style="{StaticResource MenuButton}" Content="설정" Click="SettingsClicked"/>
      <Button x:Name="Exit" Style="{StaticResource MenuButton}" Content="종료" Click="ExitClicked"/>
    </StackPanel>
    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="설정" FontSize="36" FontWeight="Bold" Margin="0,0,0,32"/>
      <TextBlock Text="해상도 · 창 크기" FontSize="18" Margin="0,0,0,10"/>
      <ComboBox x:Name="Resolution" FontSize="18" Padding="12" AutomationProperties.Name="창 해상도"/>
      <TextBlock Text="화면보다 큰 창은 화면에 맞게 조정됩니다." Foreground="#666666" Margin="0,8,0,24"/>
      <DockPanel><TextBlock Text="BGM" FontSize="18"/><TextBlock Text="{Binding ElementName=Bgm, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="18"/></DockPanel>
      <Slider x:Name="Bgm" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,24" AutomationProperties.Name="BGM 음량"/>
      <DockPanel><TextBlock Text="SFX" FontSize="18"/><TextBlock Text="{Binding ElementName=Sfx, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="18"/></DockPanel>
      <Slider x:Name="Sfx" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,12" AutomationProperties.Name="SFX 음량"/>
      <TextBlock Text="사운드는 추후 추가됩니다. 지금은 음량 설정만 저장합니다." Foreground="#666666" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
        <Button x:Name="Apply" Style="{StaticResource MenuButton}" Content="적용" FontSize="20" Click="ApplyClicked"/>
        <Button Style="{StaticResource MenuButton}" Content="돌아가기" FontSize="20" Click="BackClicked"/>
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="MenuStatus" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="30" Foreground="#666666" TextWrapping="Wrap"/>
  </Grid>
</Window>
