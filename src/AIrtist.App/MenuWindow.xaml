<Window x:Class="AIrtist.App.MenuWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIrtist" Width="1120" Height="820" MinWidth="940" MinHeight="740" Background="{DynamicResource PageBase}" Foreground="{DynamicResource Ink}" WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic">
  <Window.Resources>
    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="FontSize" Value="20"/><Setter Property="Padding" Value="22,17"/>
    </Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="#7958C9"/></Style>
  </Window.Resources>
  <Grid x:Name="ShellPage" Background="{DynamicResource PageBackground}">
    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
      <Button x:Name="Licenses" Content="라이선스" Click="LicensesClicked" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="16,8"/>
      <Button x:Name="Settings" Content="⚙  설정" Click="SettingsClicked" Style="{StaticResource SecondaryButton}" Padding="16,8"/>
    </StackPanel>
    <ContentControl x:Name="ScreenHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Grid Grid.Row="1" x:Name="MenuPage" ClipToBounds="True" Background="{DynamicResource PageBackground}">
    <Grid IsHitTestVisible="False" Focusable="False">
      <Ellipse Width="640" Height="640" Fill="{DynamicResource MenuGlowPurple}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-270,-310,0,0"/>
      <Ellipse Width="520" Height="520" Fill="{DynamicResource MenuGlowGreen}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-230,-220"/>
      <Border Width="224" Height="276" Background="#FDFDFC" CornerRadius="14" Padding="13" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><TransformGroup><RotateTransform Angle="-12"/><TranslateTransform X="-342" Y="76"/></TransformGroup></Border.RenderTransform>
        <Border.Effect><DropShadowEffect Color="#746787" BlurRadius="35" ShadowDepth="8" Opacity="0.12"/></Border.Effect>
        <Grid ClipToBounds="True" Background="#E9EBFA" Margin="0,0,0,20">
          <Ellipse Width="63" Height="63" Fill="#EBCBA2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,22,0"/>
          <Path Fill="#B8D8CE" Data="M -20,178 Q 35,63 112,159 Q 175,101 225,177 L 225,250 L -20,250 Z"/>
          <Path Fill="#88B8AC" Data="M -20,217 Q 67,137 140,189 Q 190,167 225,196 L 225,250 L -20,250 Z"/>
        </Grid>
      </Border>
      <Border Width="200" Height="234" Background="#FDFDFC" CornerRadius="14" Padding="13" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><TransformGroup><RotateTransform Angle="11"/><TranslateTransform X="343" Y="-82"/></TransformGroup></Border.RenderTransform>
        <Border.Effect><DropShadowEffect Color="#746787" BlurRadius="35" ShadowDepth="8" Opacity="0.12"/></Border.Effect>
        <Grid ClipToBounds="True" Background="#F4E5DD" Margin="0,0,0,20">
          <Ellipse Width="127" Height="127" Fill="#D6BDDF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-24,-29,0,0"/>
          <Path Stroke="#CB947A" StrokeThickness="28" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 26,153 C 48,64 119,154 150,50"/>
          <Ellipse Width="22" Height="22" Fill="#E1BC82" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,19"/>
        </Grid>
      </Border>
      <Path Stroke="#B9A6D7" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,12 L 24,12 M 12,0 L 12,24"><Path.RenderTransform><TransformGroup><RotateTransform Angle="14"/><TranslateTransform X="-367" Y="-170"/></TransformGroup></Path.RenderTransform></Path>
      <Ellipse Width="14" Height="14" Stroke="#99BCB0" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.RenderTransform><TranslateTransform X="336" Y="214"/></Ellipse.RenderTransform></Ellipse>
    </Grid>
    <Border Width="550" Padding="48,40" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="32" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border.Effect><DropShadowEffect Color="#73628F" BlurRadius="60" ShadowDepth="12" Opacity="0.12"/></Border.Effect>
      <Grid>
        <StackPanel x:Name="MainMenu" Width="350" HorizontalAlignment="Center">
          <Border Width="70" Height="70" Background="{DynamicResource AccentSoft}" CornerRadius="22" HorizontalAlignment="Center" Margin="0,0,0,12" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><RotateTransform Angle="-7"/></Border.RenderTransform>
            <Viewbox Margin="17"><Canvas Width="36" Height="36"><Path Fill="#8663CE" Data="M 11,24 L 27,4 Q 30,1 33,4 Q 36,7 33,10 L 16,28 Z"/><Path Fill="{DynamicResource HoverBorder}" Data="M 11,25 Q 2,22 4,31 Q 4,34 0,35 Q 15,38 16,29 Z"/><Path Stroke="{DynamicResource AccentSoft}" StrokeThickness="2" Data="M 24,8 L 30,13"/></Canvas></Viewbox>
          </Border>
          <TextBlock FontFamily="Segoe UI" FontSize="59" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,32"><Run Text="AI" Foreground="{DynamicResource Accent}"/><Run Text="rtist"/></TextBlock>
          <Button x:Name="Single" Style="{StaticResource MenuButton}" Content="그림 그리기" Click="SingleClicked" Foreground="White" BorderBrush="#7650BD" Background="{DynamicResource PrimaryBackground}"/>
          <Button x:Name="Multi" Style="{StaticResource MenuButton}" Content="멀티 플레이" Click="MultiClicked" Margin="0,14,0,0"/>
          <UniformGrid Columns="1" Margin="0,22,0,0">
            <Button x:Name="Exit" Style="{StaticResource MenuButton}" Content="종료" Click="ExitClicked" FontSize="17" Padding="18,13" Background="{DynamicResource FieldSurface}" BorderBrush="{DynamicResource CardBorder}"/>
          </UniformGrid>
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock x:Name="MenuStatus" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="30" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
  </Grid>
    <Grid x:Name="SettingsOverlay" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Overlay}">
      <Border Style="{StaticResource Card}" Width="540" MaxHeight="{Binding ActualHeight, ElementName=SettingsOverlay}" Padding="36,24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SettingsPanel" Width="440" HorizontalAlignment="Center">
          <TextBlock Text="설정" FontSize="32" FontWeight="Bold" Margin="0,0,0,18"/>
          <TextBlock Text="화면 모드" FontSize="17" Margin="0,0,0,8"/>
          <ComboBox x:Name="ThemeChoice" FontSize="17" Margin="0,0,0,18"><ComboBoxItem Content="라이트 모드"/><ComboBoxItem Content="다크 모드"/></ComboBox>
          <TextBlock Text="해상도 · 창 크기" FontSize="17" Margin="0,0,0,10"/>
          <ComboBox x:Name="Resolution" FontSize="18" Padding="12" AutomationProperties.Name="창 해상도"/>
          <TextBlock Text="화면보다 큰 창은 화면에 맞게 조정됩니다." Foreground="{DynamicResource Muted}" Margin="0,8,0,24"/>
          <DockPanel><TextBlock Text="BGM" FontSize="17"/><TextBlock Text="{Binding ElementName=Bgm, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="17"/></DockPanel>
          <Slider x:Name="Bgm" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,24" AutomationProperties.Name="BGM 음량" ValueChanged="VolumeChanged"/>
          <DockPanel><TextBlock Text="SFX" FontSize="17"/><TextBlock Text="{Binding ElementName=Sfx, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="17"/></DockPanel>
          <Slider x:Name="Sfx" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,12" AutomationProperties.Name="SFX 음량" ValueChanged="VolumeChanged"/>
<TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
          <UniformGrid Columns="2" Margin="0,28,0,0">
            <Button x:Name="Apply" Style="{StaticResource MenuButton}" Content="적용" FontSize="18" Click="ApplyClicked" Margin="0,0,7,0"/>
            <Button Style="{StaticResource MenuButton}" Content="돌아가기" FontSize="18" Click="BackClicked" Margin="7,0,0,0"/>
          </UniformGrid>
        </StackPanel>

        </ScrollViewer>
      </Border>
    </Grid>
    <Grid x:Name="LicenseOverlay" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Overlay}"
          KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="LicenseKeyDown">
      <Border Style="{StaticResource Card}" MaxWidth="960" Margin="24" Padding="24">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="라이선스" FontSize="28" FontWeight="Bold" Margin="0,0,0,16"/>
          <ComboBox x:Name="LicenseChoice" Grid.Row="1" AutomationProperties.Name="라이선스 문서" DisplayMemberPath="Title"
                    SelectionChanged="LicenseSelectionChanged" Margin="0,0,0,16"/>
          <TextBox x:Name="LicenseText" Grid.Row="2" IsReadOnly="True" IsReadOnlyCaretVisible="True" IsUndoEnabled="False"
                   TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" Padding="16" VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="라이선스 내용"/>
          <Button x:Name="LicenseClose" Grid.Row="3" Content="닫기" Click="CloseLicenseClicked" Style="{StaticResource SecondaryButton}"
                  HorizontalAlignment="Right" MinWidth="120" Margin="0,16,0,0"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
