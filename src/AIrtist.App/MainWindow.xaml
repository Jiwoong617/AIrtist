<Window x:Class="AIrtist.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AIrtist.App"
        Title="AIrtist · 그림그리기" Width="1120" Height="820" MinWidth="940" MinHeight="740" Background="#111824" Foreground="#EDF1F6" WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111824"/><Setter Property="Foreground" Value="#EDF1F6"/><Setter Property="CaretBrush" Value="#A7E3C2"/><Setter Property="BorderBrush" Value="#45556B"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="16"/></Style>
  </Window.Resources>
  <Grid x:Name="Page" Margin="24" Background="#111824">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="Home" Content="메인 화면" Click="HomeClicked" Margin="0,0,10,0"/>
        <Button x:Name="Online" Content="온라인 방" Click="OnlineClicked" Visibility="Collapsed" IsEnabled="False"/>
        <Button x:Name="VotingPreview" Content="경기 미리보기" Click="VotingClicked" Visibility="Collapsed" IsEnabled="False"/>
      </StackPanel>
      <StackPanel><TextBlock Text="AIrtist" FontSize="28" FontWeight="Bold"/><TextBlock Text="원하는 장면을 자유롭게 그려 보세요" Foreground="{StaticResource Muted}"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#1B2534" CornerRadius="14" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <TextBlock Text="생성 설정" FontSize="19" FontWeight="Bold" Margin="0,0,0,20"/>
          <local:ParameterEditor x:Name="Parameters" IsEnabled="False"/>
          <TextBlock x:Name="UsedParameters" TextWrapping="Wrap" Foreground="#A7E3C2" FontSize="12" Margin="0,20,0,0"/>
        </StackPanel></ScrollViewer>
      </Border>
      <Border Grid.Column="2" Background="#1B2534" CornerRadius="14" Padding="18">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="#121C29" CornerRadius="10"><Grid>
            <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="✦" FontSize="54" Foreground="#A7E3C2" HorizontalAlignment="Center"/>
              <TextBlock Text="아래에 원하는 그림을 적어 주세요" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
            </StackPanel>
            <Image x:Name="GeneratedImage" Stretch="Uniform" AutomationProperties.Name="생성된 그림"/>
          </Grid></Border>
          <StackPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock x:Name="StatusLabel" Text="모델 파일을 확인하고 있어요" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Activity" Height="3" Margin="0,8,0,0" IsIndeterminate="True" Foreground="#A7E3C2" Background="#344052"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#1B2534" CornerRadius="14" Padding="16" Margin="0,16,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
        <Grid>
          <StackPanel x:Name="DescriptionPanel"><TextBlock Text="무엇을 그릴까요?" FontWeight="Bold" Margin="0,0,0,7"/>
            <TextBox x:Name="Description" Height="76" MaxLength="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="DescriptionChanged" IsEnabled="False" AutomationProperties.Name="자유로운 그림 묘사 입력"/>
            <TextBlock x:Name="LengthLabel" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel x:Name="ReviewPanel" Visibility="Collapsed"><TextBlock Text="영어 묘사 확인 · 원문과 다르면 고쳐 주세요" FontWeight="Bold" Margin="0,0,0,7"/>
            <TextBox x:Name="ReviewedTranslation" Height="76" MaxLength="320" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TranslationChanged" AutomationProperties.Name="생성 전 영어 묘사 확인 및 수정"/>
            <DockPanel Margin="0,5,0,0"><Button x:Name="ReviseDescription" Content="원문 다시 쓰기" Click="ReviseClicked" Padding="8,3" Background="#344052" Foreground="#EDF1F6" DockPanel.Dock="Right"/>
              <TextBlock x:Name="TranslationLengthLabel" FontSize="11" Foreground="{StaticResource Muted}"/>
            </DockPanel>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <Button x:Name="Submit" Content="그림 그리기" Click="SubmitClicked" IsEnabled="False" IsDefault="False"/>
          <Button x:Name="EditDescription" Content="묘사 수정" Click="EditClicked" Visibility="Collapsed" IsEnabled="False"/>
          <Button x:Name="Cancel" Content="취소" Click="CancelClicked" IsEnabled="False" Background="#344052" Foreground="#EDF1F6" Margin="0,6,0,0" Padding="10,6"/>
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock x:Name="TranslationLabel" Grid.Row="3" Text="이 PC에서 생성합니다 · 앱을 닫으면 그림은 보관되지 않습니다" TextWrapping="Wrap" MaxHeight="42" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
  </Grid>
</Window>
