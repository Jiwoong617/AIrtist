<Window x:Class="AIrtist.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIrtist · 이미지 묘사" Width="1120" Height="800" MinWidth="940" MinHeight="740" Background="#111824" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic">
  <Grid x:Name="Page" Margin="32" Background="#111824">
    <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="AIrtist" FontSize="30" FontWeight="Bold"/><TextBlock Text="이름을 말하지 않고, 그림으로 전해 보세요" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
        <Border Background="#22392F" CornerRadius="16" Padding="14,7"><TextBlock x:Name="RoundLabel" Text="●  오프라인 경기" Foreground="#A7E3C2" FontSize="12"/></Border>
        <TextBlock x:Name="TimerLabel" Text="" HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#1B2534" CornerRadius="18" Padding="26">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="오늘의 제시어" Foreground="#A7E3C2" FontSize="12"/>
            <TextBlock x:Name="WordLabel" Text="준비 중" FontSize="38" FontWeight="Bold" Margin="0,10,0,6"/>
            <TextBlock x:Name="MeaningLabel" Text="모델 파일을 확인하고 있어요" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="22"/>
            <Border Height="1" Background="#344052" Margin="0,22,0,20"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="당신의 묘사" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="색, 모양, 특징을 떠올려 적어 보세요." Foreground="{StaticResource Muted}" Margin="0,7,0,12"/>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <TextBox x:Name="Description" Height="145" MaxLength="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="13" Background="#111824" Foreground="#EDF1F6" CaretBrush="#A7E3C2" BorderBrush="#45556B" FontSize="16" TextChanged="DescriptionChanged" IsEnabled="False" AutomationProperties.Name="그림 묘사 입력"/>
            <TextBlock x:Name="LengthLabel" Text="0 / 160 · Enter는 줄바꿈" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,12" HorizontalAlignment="Right"/>
            <TextBlock x:Name="AliasLabel" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" LineHeight="19"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <Button x:Name="Submit" Content="한 장 그리기" Click="SubmitClicked" IsEnabled="False" IsDefault="False"/>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="Cancel" Content="취소" Click="CancelClicked" IsEnabled="False" Background="#344052" Foreground="#EDF1F6"/>
              <Button x:Name="Next" Grid.Column="2" Content="건너뛰기" Click="NextClicked" IsEnabled="False" Background="#344052" Foreground="#EDF1F6"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="#1B2534" CornerRadius="18" Padding="22">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="#121C29" CornerRadius="12" ClipToBounds="True">
            <Grid>
              <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="✦" FontSize="54" Foreground="#A7E3C2" HorizontalAlignment="Center"/>
                <TextBlock Text="당신의 말이 그림이 되는 곳" FontSize="17" Margin="0,20,0,8" HorizontalAlignment="Center"/>
                <TextBlock Text="묘사를 제출하면 여기에 한 장을 그려요" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/>
              </StackPanel>
              <Image x:Name="GeneratedImage" Stretch="Uniform" AutomationProperties.Name="생성된 그림"/>
            </Grid>
          </Border>
          <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock x:Name="StatusLabel" Text="모델 파일을 확인하고 있어요" TextWrapping="Wrap" FontSize="14" LineHeight="23"/>
            <ProgressBar x:Name="Activity" Height="3" Margin="0,10,0,0" IsIndeterminate="True" Foreground="#A7E3C2" Background="#344052"/>
          </StackPanel>
          <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TranslationLabel" Text="묘사는 이 PC에서 번역·생성·평가됩니다" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1"><TextBlock Text="평가점 · 검증 중" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><TextBlock x:Name="ScoreLabel" Text="—" FontSize="30" FontWeight="Bold" Foreground="#A7E3C2" HorizontalAlignment="Right"/></StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="번역·평가점은 검증 중입니다 · 실패·취소·시간 초과·건너뛰기는 0점 · 점수는 정답 확률이 아닙니다" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/>
    <Border x:Name="MatchPanel" Grid.Row="1" Margin="0,14,0,0" Background="#1B2534" CornerRadius="18" Padding="36">
      <Grid>
        <StackPanel x:Name="SetupPanel" VerticalAlignment="Center" MaxWidth="500">
          <TextBlock Text="말로 그리는 한 경기" FontSize="32" FontWeight="Bold"/>
          <TextBlock Text="이름을 숨겨 묘사하고, 그림의 평가점을 모아 보세요." Foreground="{StaticResource Muted}" Margin="0,12,0,30"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="라운드 수" Margin="0,0,0,8"/><ComboBox x:Name="RoundsSetting" SelectedIndex="0" FontSize="16" Padding="8"><ComboBoxItem Content="3"/><ComboBoxItem Content="5"/><ComboBoxItem Content="8"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="작성 시간 (초)" Margin="0,0,0,8"/><ComboBox x:Name="WritingSetting" SelectedIndex="1" FontSize="16" Padding="8"><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/><ComboBoxItem Content="120"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="AI 처리 시간 (초)" Margin="0,0,0,8"/><ComboBox x:Name="AiSetting" SelectedIndex="1" FontSize="16" Padding="8"><ComboBoxItem Content="60"/><ComboBoxItem Content="180"/><ComboBoxItem Content="300"/></ComboBox></StackPanel>
          </Grid>
          <TextBlock Text="한 경기 안에서는 같은 제시어가 다시 나오지 않아요.&#10;제출 승인 후 한 번만 생성하며, 실패한 라운드는 0점이에요." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="24" Margin="0,24,0,24"/>
          <Button x:Name="StartMatch" Content="경기 시작" Click="StartClicked" IsEnabled="False"/>
          <TextBlock x:Name="SetupStatus" Text="모델 파일을 확인하고 있어요" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
        </StackPanel>
        <Grid x:Name="SummaryPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="경기를 마쳤어요" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="TotalLabel" FontSize="24" Foreground="#A7E3C2" Margin="0,12,0,8"/><TextBlock x:Name="AverageLabel" Foreground="{StaticResource Muted}" Margin="0,0,0,22"/></StackPanel>
          <ListBox x:Name="RoundHistory" Grid.Row="1" Background="#121C29" Foreground="#EDF1F6" BorderThickness="0" Padding="12" FontFamily="Malgun Gothic" FontSize="15" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          <Button Grid.Row="2" Content="새 경기 설정" Click="RestartClicked" HorizontalAlignment="Right" Margin="0,22,0,0"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
