<Window x:Class="AIrtist.App.OnlineRoomWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AIrtist.App"
 Title="AIrtist · 멀티 플레이" Width="1120" Height="820" MinWidth="940" MinHeight="740" Background="{StaticResource PageBackground}" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner" FontFamily="Malgun Gothic" FontSize="14">
 <Window.Resources>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="FontSize" Value="17"/><Setter Property="Padding" Value="10,7"/><Setter Property="MinWidth" Value="110"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="17"/><Setter Property="Padding" Value="22,14"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="FontSize" Value="17"/><Setter Property="Padding" Value="22,14"/></Style>
 </Window.Resources>
 <Grid x:Name="Page" Margin="36" Background="{StaticResource PageBackground}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,24">
   <Button x:Name="CodeBadge" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Primary}" Click="CopyCodeClicked" Visibility="Collapsed" ToolTip="클릭해서 방 코드 복사" AutomationProperties.Name="방 코드 복사"/>
   <StackPanel Orientation="Horizontal"><Button Content="‹" Style="{StaticResource Secondary}" Click="BackClicked" Padding="18,5" FontSize="28" Margin="0,0,16,0" AutomationProperties.Name="뒤로"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock FontFamily="Segoe UI" FontWeight="Bold" FontSize="28"><Run Text="AI" Foreground="{StaticResource Accent}"/><Run Text="rtist"/></TextBlock>
     <Border Width="1" Height="24" Background="{StaticResource CardBorder}" Margin="20,0"/>
     <TextBlock Text="멀티 플레이" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
   </StackPanel>
  </DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid VerticalAlignment="Center">
    <StackPanel x:Name="ChoicePanel" MaxWidth="860" HorizontalAlignment="Center">
     <UniformGrid Columns="2">
      <Button x:Name="ChooseCreate" Click="ChooseCreateClicked" Style="{StaticResource SecondaryButton}" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}" Padding="30" Margin="0,0,12,0">
       <StackPanel Width="270"><TextBlock Text="＋" FontSize="54" Foreground="{StaticResource Accent}" Margin="0,0,0,20"/><TextBlock Text="방 생성" FontSize="27" FontWeight="Bold"/></StackPanel>
      </Button>
      <Button x:Name="ChooseJoin" Click="ChooseJoinClicked" Style="{StaticResource SecondaryButton}" Background="{StaticResource AccentSoft}" Foreground="{StaticResource Ink}" Padding="30" Margin="12,0,0,0">
       <StackPanel Width="270"><TextBlock Text="↗" FontSize="54" Foreground="{StaticResource Accent}" Margin="0,0,0,20"/><TextBlock Text="방 참가" FontSize="27" FontWeight="Bold"/></StackPanel>
      </Button>
     </UniformGrid>
    </StackPanel>
    <Border x:Name="CreatePanel" Visibility="Collapsed" Style="{StaticResource Card}" Padding="32" Width="680" HorizontalAlignment="Center">
     <StackPanel><TextBlock Text="방 생성" FontSize="30" FontWeight="Bold" Margin="0,0,0,26"/>
      <UniformGrid Columns="2"><StackPanel Margin="0,0,18,16"><TextBlock Text="최대 인원" Margin="0,0,0,8"/><ComboBox x:Name="Capacity"/></StackPanel><StackPanel Margin="0,0,0,16"><TextBlock Text="라운드 수" Margin="0,0,0,8"/><ComboBox x:Name="RoomRounds"/></StackPanel><StackPanel Margin="0,0,18,20"><TextBlock Text="묘사 작성 시간 · 초" Margin="0,0,0,8"/><ComboBox x:Name="RoomWriting"/></StackPanel><StackPanel Margin="0,0,0,20"><TextBlock Text="이미지 생성 시간 · 초" Margin="0,0,0,8"/><ComboBox x:Name="RoomGeneration"/></StackPanel></UniformGrid>
      <Border Background="{StaticResource PageBackground}" CornerRadius="12" Padding="18" Margin="0,0,0,24"><StackPanel>
       <CheckBox x:Name="LockRoomParameters" Content="방 파라미터 설정" FontSize="16" Foreground="{StaticResource Ink}" Checked="RoomParametersChanged" Unchecked="RoomParametersChanged"/>
       <Border x:Name="ParameterSurface" Background="{StaticResource Surface}" CornerRadius="10" Padding="18" Margin="0,14,0,0" Visibility="Collapsed"><local:ParameterEditor x:Name="RoomParameters" Visibility="Collapsed" Foreground="{StaticResource Ink}"/></Border>
      </StackPanel></Border>
      <Button x:Name="Create" Content="방 만들기" Style="{StaticResource Primary}" Click="CreateClicked"/>
     </StackPanel>
    </Border>
    <Border x:Name="JoinPanel" Visibility="Collapsed" Style="{StaticResource Card}" Padding="44" Width="540" HorizontalAlignment="Center">
     <StackPanel><TextBlock Text="방 참가" FontSize="29" FontWeight="Bold" Margin="0,0,0,26"/><TextBlock Text="방 코드 (10자리)" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,0,12"/>
      <TextBox x:Name="CodeInput" MaxLength="32" CharacterCasing="Upper" FontSize="28" FontFamily="Consolas" TextAlignment="Center" AutomationProperties.Name="참가할 방 코드" Margin="0,0,0,26"/>
      <Button x:Name="Join" Content="방 참가" Style="{StaticResource Primary}" Click="JoinClicked"/>
     </StackPanel>
    </Border>
    <Border x:Name="WaitingPanel" Visibility="Collapsed" Style="{StaticResource Card}" Padding="32" Width="680" HorizontalAlignment="Center">
     <StackPanel><TextBlock Text="대기방" FontSize="30" FontWeight="Bold" Margin="0,0,0,24"/>
      <TextBlock x:Name="Members" FontWeight="Bold" FontSize="17" Margin="0,0,0,14"/>
      <ItemsControl x:Name="MemberCards"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource PageBackground}" Padding="16,12" CornerRadius="10" Margin="0,0,0,8"><DockPanel><TextBlock Text="●" Foreground="{StaticResource Accent}" Margin="0,0,14,0"/><TextBlock Text="{Binding}" FontSize="16"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Button x:Name="Prepare" Content="게임 준비" Style="{StaticResource Primary}" Click="PrepareClicked" Margin="0,18,0,0"/>
      <Button x:Name="OpenGame" Content="게임 대기방으로" Style="{StaticResource Primary}" Click="OpenGameClicked" Visibility="Collapsed" Margin="0,8,0,0"/>
      <Button x:Name="Leave" Content="방 나가기" Style="{StaticResource Secondary}" Click="LeaveClicked" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,20,0,0"><ProgressBar x:Name="Connecting" IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Visibility="Collapsed"/><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
   <Button x:Name="Retry" Content="다시 연결" Style="{StaticResource Secondary}" Click="RetryClicked" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,0"/>
  </StackPanel>
 </Grid>
</Window>
